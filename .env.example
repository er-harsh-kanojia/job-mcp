# ==============================================================================
# Job MCP - Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to .env:
#   Windows (CMD):        copy .env.example .env
#   Windows (PowerShell): cp .env.example .env
#   Linux / Mac:          cp .env.example .env
#
# NOTE: The core Job Search and Apply functions (Naukri, Instahyre, Hirist) work
# completely fine without any AI keys.
#
# To use the AI "Resume and prep" features (Resume Review, ATS Scoring,
# Skill Demand analysis, 2-Week Interview Prep Plan, and Mock Interviews),
# you MUST provide at least ONE API key below (Anthropic or OpenAI).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Keys (at least one is required for Resume Analyzer & Mock Interview)
# ------------------------------------------------------------------------------

# Anthropic API Key (Claude)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API Key (ChatGPT / GPT-4o / GPT-6)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Optional AI Model Overrides (defaults to best available if left commented)
# ------------------------------------------------------------------------------
# Default analysis models:
# JOB_MCP_ANTHROPIC_MODEL=claude-opus-5-5
# JOB_MCP_OPENAI_MODEL=gpt-6.1-sol

# Faster/cheaper models for interactive Mock Interview chat turns:
# JOB_MCP_ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
# JOB_MCP_OPENAI_CHAT_MODEL=gpt-6-luna

# Reasoning effort levels (low, medium, high):
# JOB_MCP_ANTHROPIC_EFFORT=high
# JOB_MCP_OPENAI_EFFORT=high

# ------------------------------------------------------------------------------
# 3. Optional Automation & Browser Settings
# ------------------------------------------------------------------------------
# JOB_MCP_HEADLESS=1                 # Set to 1 to run Playwright in headless mode
# JOB_MCP_BROWSER_CHANNEL=chrome    # Use your installed Google Chrome instead of Chromium
# JOB_MCP_LIMIT_PER_PLATFORM=40     # Max jobs fetched per platform in one search
# JOB_MCP_DELAY_MIN=2               # Minimum human pause delay (seconds) between applications
# JOB_MCP_DELAY_MAX=5               # Maximum human pause delay (seconds) between applications
